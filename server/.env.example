# Copy to server/.env (never commit the real file). Read by server/index.js.
SERPAPI_API_KEY=YOUR_SERPAPI_API_KEY
# The public HTTPS address of this site — Google Lens downloads the photo from here.
PUBLIC_BASE_URL=https://YOUR-IP-WITH-DASHES.sslip.io
PORT=8787

# Meta Model API (Muse Spark + Muse Voice Transcribe) — https://dev.meta.ai/docs
MUSE_API_KEY=YOUR_MUSE_API_KEY
# Optional overrides (defaults shown):
# MUSE_MODEL=muse-spark-1.3
# MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# MUSE_BASE_URL=https://api.meta.ai/v1

# Demo switch: every scan returns poison hemlock without calling SerpAPI (Muse still narrates).
# Remove this line (and restart) to scan for real.
# DEMO_SCAN=poison-hemlock
