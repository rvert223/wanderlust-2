# Copy this file to `.env` and replace the YOUR_* placeholders.
# Anything left as a placeholder (or empty) makes that connector fall back to its
# built-in mock, so the app is always demo-able. All values are read in src/config/env.js.

# --- Wanderlust backend (sightings, users, alerts) ---
VITE_API_BASE_URL=YOUR_API_BASE_URL
VITE_ALERTS_WS_URL=YOUR_ALERTS_WS_URL

# --- SerpAPI Google Lens (visual search) ---
# The SerpAPI key goes in server/.env, NOT here (see server/.env.example).
# The website only needs the server route; the default is right for the Vultr setup.
# VITE_SERPAPI_LENS_URL=/api/serp/lens

# --- Meta Muse (Muse Spark scan agent, Paranormal Investigator, Voice Transcribe) ---
VITE_MUSE_API_KEY=YOUR_MUSE_API_KEY
VITE_MUSE_AGENT_URL=YOUR_MUSE_AGENT_URL
# Optional: a separate Muse Spark endpoint for scan analysis (defaults to VITE_MUSE_AGENT_URL)
# VITE_MUSE_SCAN_URL=
VITE_MUSE_TRANSCRIBE_URL=YOUR_MUSE_TRANSCRIBE_URL

# --- Facebook Graph API (places + nearby verified experts) ---
VITE_FACEBOOK_ACCESS_TOKEN=YOUR_FACEBOOK_ACCESS_TOKEN
VITE_FACEBOOK_NEARBY_EXPERTS_PATH=YOUR_NEARBY_EXPERTS_PATH

# --- Optional Python (scipy/librosa) infrasound analysis service ---
VITE_INFRASOUND_BACKEND_URL=YOUR_INFRASOUND_BACKEND_URL

# Set to "false" to hide the demo-capture fallback (live camera only).
VITE_ALLOW_DEMO_CAPTURE=true
